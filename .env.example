# Public hostname the app is served on in production. Needed only for the
# Docker deploy (build arg): Astro trusts the proxy's X-Forwarded-* headers
# for this host so the CSRF origin check works behind TLS termination.
SITE_HOSTNAME=lunch.example.com
# Shared passcode that gates the whole app
SITE_PASSCODE=changeme
# Separate passcode that grants admin rights
ADMIN_PASSCODE=changeme-admin
# HMAC key for signing the auth cookie (any long random string)
SESSION_SECRET=generate-a-long-random-string
# Path to the SQLite database file
DATABASE_PATH=./data/lunch.db
