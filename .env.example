# Public hostname the app is served on in production. Needed only for the
# Docker deploy (build arg): Astro trusts the proxy's X-Forwarded-* headers
# for this host so the CSRF origin check works behind TLS termination.
SITE_HOSTNAME=lunch.example.com
# First-boot seed for the Default tenant's member/admin passcodes. Applied
# only while the tenant's passcodes are unset — rotate them on /tenants
# afterwards; later edits here are ignored.
SITE_PASSCODE=changeme
ADMIN_PASSCODE=changeme-admin
# Global superadmin passcode: logs into tenant management (/tenants) with
# the login form's organization field left blank. Unset = no superadmin login.
SUPERADMIN_PASSCODE=changeme-super
# HMAC key for signing the auth cookie (any long random string)
SESSION_SECRET=generate-a-long-random-string
# Path to the SQLite database file
DATABASE_PATH=./data/lunch.db
# Optional, dev only: set to 1 to let anyone rate a place without having
# eaten there — for previewing the rating UI. Never enable in production.
#RATE_WITHOUT_VISIT=1
