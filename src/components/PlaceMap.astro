---
export interface MapMarker {
  lat: number;
  lng: number;
  name: string;
  slug?: string;
}

interface Props {
  markers: MapMarker[];
  class?: string;
}

const { markers, class: className = "rounded-box h-64 shadow-sm" } =
  Astro.props;
---

<div
  class={`place-map relative z-0 w-full overflow-hidden ${className}`}
  data-markers={JSON.stringify(markers)}
>
</div>

<style is:global>
  /* MapLibre's popup is hardcoded white; the link inside inherits the page's
     base-content color, which is white in the dark theme. Re-skin the bubble
     (and its tip, colored per anchor side) with the active theme's colors.
     Scoped under .place-map so these outweigh maplibre-gl.css, which the
     bundler injects after this block. */
  .place-map .maplibregl-popup-content {
    background: var(--color-base-100);
    color: var(--color-base-content);
  }
  .place-map .maplibregl-popup-anchor-top .maplibregl-popup-tip,
  .place-map .maplibregl-popup-anchor-top-left .maplibregl-popup-tip,
  .place-map .maplibregl-popup-anchor-top-right .maplibregl-popup-tip {
    border-bottom-color: var(--color-base-100);
  }
  .place-map .maplibregl-popup-anchor-bottom .maplibregl-popup-tip,
  .place-map .maplibregl-popup-anchor-bottom-left .maplibregl-popup-tip,
  .place-map .maplibregl-popup-anchor-bottom-right .maplibregl-popup-tip {
    border-top-color: var(--color-base-100);
  }
  .place-map .maplibregl-popup-anchor-left .maplibregl-popup-tip {
    border-right-color: var(--color-base-100);
  }
  .place-map .maplibregl-popup-anchor-right .maplibregl-popup-tip {
    border-left-color: var(--color-base-100);
  }

  /* MapLibre always auto-expands the compact attribution on load (there is
     no start-collapsed option). Override its expanded-state rules so it
     stays a plain ⓘ button and only reveals the credits on hover/focus. */
  .place-map
    .maplibregl-ctrl-attrib.maplibregl-compact-show:not(:hover):not(
      :focus-within
    ) {
    padding: 2px 24px 2px 0;
  }
  .place-map
    .maplibregl-ctrl-attrib.maplibregl-compact-show:not(:hover):not(
      :focus-within
    )
    .maplibregl-ctrl-attrib-inner {
    display: none;
  }
</style>

<script>
  import * as maplibregl from "maplibre-gl";
  import workerUrl from "maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url";
  import "maplibre-gl/dist/maplibre-gl.css";

  maplibregl.setWorkerUrl(workerUrl);

  interface MapMarker {
    lat: number;
    lng: number;
    name: string;
    slug?: string;
  }

  const STYLES = {
    light: "https://tiles.openfreemap.org/styles/positron",
    dark: "https://tiles.openfreemap.org/styles/dark",
  };
  const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");
  const styleFor = () => (darkQuery.matches ? STYLES.dark : STYLES.light);

  for (const el of document.querySelectorAll<HTMLElement>(".place-map")) {
    const markers = JSON.parse(el.dataset.markers ?? "[]") as MapMarker[];
    if (markers.length === 0) continue;

    const map = new maplibregl.Map({
      container: el,
      style: styleFor(),
      attributionControl: { compact: true },
      cooperativeGestures: true,
    });
    map.addControl(
      new maplibregl.NavigationControl({ showCompass: false }),
      "bottom-right",
    );

    const bounds = new maplibregl.LngLatBounds();
    for (const m of markers) {
      bounds.extend([m.lng, m.lat]);
      // Place names are user input — build popup content as DOM, not HTML.
      const label = m.slug
        ? Object.assign(document.createElement("a"), {
            href: `/places/${m.slug}`,
            className: "link font-medium",
          })
        : document.createElement("span");
      label.textContent = m.name;
      new maplibregl.Marker()
        .setLngLat([m.lng, m.lat])
        .setPopup(new maplibregl.Popup({ offset: 24 }).setDOMContent(label))
        .addTo(map);
    }

    if (markers.length === 1) {
      map.jumpTo({ center: [markers[0]!.lng, markers[0]!.lat], zoom: 15 });
    } else {
      map.fitBounds(bounds, { padding: 48, maxZoom: 15, animate: false });
    }

    // DOM markers survive setStyle, so no re-setup needed on theme change.
    darkQuery.addEventListener("change", () => map.setStyle(styleFor()));
  }
</script>
