---
import NavLink from "./NavLink.astro";
import ThemeToggle from "./ThemeToggle.astro";

const user = Astro.locals.user;
---

{
  user && (
    <nav class="border-base-300 bg-base-100/80 sticky top-0 z-30 border-b backdrop-blur">
      <div class="mx-auto flex h-14 w-full max-w-3xl items-center gap-4 px-4">
        <a
          href="/"
          class="flex shrink-0 items-center gap-1.5 font-semibold tracking-tight"
        >
          <span aria-hidden="true">🍽️</span>
          <span class="max-sm:hidden">Lunch</span>
        </a>
        <div class="flex h-full flex-1 items-center gap-1">
          <NavLink href="/">Today</NavLink>
          <NavLink href="/places">Places</NavLink>
          <NavLink href="/map">Map</NavLink>
          <NavLink href="/history">History</NavLink>
        </div>
        <div class="flex shrink-0 items-center gap-3">
          <ThemeToggle />
          <span class="text-base-content/70 text-sm max-sm:hidden">
            {user.name}
            {user.role === "admin" && (
              <span class="badge badge-warning badge-xs ml-1">
                admin
              </span>
            )}
          </span>
          <form method="POST" action="/api/logout">
            <button
              class="text-base-content/60 hover:text-base-content cursor-pointer text-sm transition-colors"
              type="submit"
            >
              Log out
            </button>
          </form>
        </div>
      </div>
    </nav>
  )
}
