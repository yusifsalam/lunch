---
interface Props {
  href: string;
}

const { href } = Astro.props;
const path = Astro.url.pathname;
const active = href === "/" ? path === "/" : path.startsWith(href);
---

<a
  href={href}
  aria-current={active ? "page" : undefined}
  class:list={[
    "relative flex h-full items-center px-2 text-sm transition-colors",
    active
      ? "text-base-content after:bg-primary font-medium after:absolute after:inset-x-2 after:-bottom-px after:h-0.5 after:rounded-full"
      : "text-base-content/60 hover:text-base-content",
  ]}
>
  <slot />
</a>
