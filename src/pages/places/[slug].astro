---
import Layout from "@/layouts/Layout.astro";
import DatePicker from "@/components/DatePicker.astro";
import PlaceMap from "@/components/PlaceMap.astro";
import { actions } from "astro:actions";
import { WEEKDAY_NAMES } from "@/lib/hours";
import { todayInfo } from "@/lib/lunch";
import { formatPrice } from "@/lib/money";
import { service } from "@/lib/service";
import { TZ } from "@/lib/lunchService";
import { parseTagsJson } from "@/lib/tags";

// Editing can rename the place and thus change its slug; follow it so the
// post-submit render doesn't 404 on the old URL.
const editResult = Astro.getActionResult(actions.places.edit);
if (editResult?.data && editResult.data.slug !== Astro.params.slug) {
  return Astro.redirect(`/places/${editResult.data.slug}`);
}
const editError = editResult?.error?.message;

const detail = await service.placeDetail(Astro.params.slug ?? "");
if (!detail) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

const { place, chosenIn, totalVotes, menu, hours, closures, closedReason } =
  detail;
const isAdmin = Astro.locals.user.role === "admin";
const { date: today } = todayInfo(new Date(), TZ);

const addItemResult = Astro.getActionResult(actions.menu.addItem);
const recordPriceResult = Astro.getActionResult(actions.menu.recordPrice);
const menuError =
  addItemResult?.error?.message ?? recordPriceResult?.error?.message;

const setHoursResult = Astro.getActionResult(actions.places.setHours);
const addClosureResult = Astro.getActionResult(actions.places.addClosure);
const deleteClosureResult = Astro.getActionResult(actions.places.deleteClosure);
const hoursError =
  setHoursResult?.error?.message ??
  addClosureResult?.error?.message ??
  deleteClosureResult?.error?.message;

const modeEmoji: Record<string, string> = {
  democracy: "🗳️",
  dictatorship: "👑",
  random: "🎲",
};
---

<Layout title={`${place.name} — Lunch`}>
  <div class="flex flex-col gap-4">
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="text-2xl font-bold">{place.name}</h1>
      {
        place.cuisine && (
          <span class="badge badge-outline">{place.cuisine}</span>
        )
      }
      {
        parseTagsJson(place.tags).map((tag) => (
          <span class="badge badge-soft">{tag}</span>
        ))
      }
      {place.archived === 1 && <span class="badge badge-ghost">archived</span>}
      {
        closedReason && (
          <span class="badge badge-warning">closed today — {closedReason}</span>
        )
      }
      {
        isAdmin && (
          <button
            class="btn btn-sm ml-auto"
            onclick="edit_place_modal.showModal()"
          >
            Edit
          </button>
        )
      }
    </div>

    {
      isAdmin && (
        <dialog id="edit_place_modal" class="modal backdrop-blur-sm">
          <div class="modal-box">
            <h2 class="mb-4 text-lg font-bold">Edit place</h2>
            {editError && (
              <div class="alert alert-error mb-4 text-sm">{editError}</div>
            )}
            <form
              method="POST"
              action={actions.places.edit}
              class="flex flex-col gap-3"
            >
              <input type="hidden" name="id" value={place.id} />
              <label class="flex flex-col gap-1">
                <span class="label-text">Name</span>
                <input
                  name="name"
                  class="input input-bordered w-full"
                  required
                  maxlength="80"
                  value={place.name}
                />
              </label>
              <label class="flex flex-col gap-1">
                <span class="label-text">URL (optional)</span>
                <input
                  name="url"
                  type="url"
                  class="input input-bordered w-full"
                  placeholder="https://…"
                  value={place.url ?? ""}
                />
              </label>
              <label class="flex flex-col gap-1">
                <span class="label-text">Notes (optional)</span>
                <input
                  name="notes"
                  class="input input-bordered w-full"
                  maxlength="500"
                  value={place.notes ?? ""}
                />
              </label>
              <label class="flex flex-col gap-1">
                <span class="label-text">Cuisine</span>
                <input
                  name="cuisine"
                  list="cuisines"
                  class="input input-bordered w-full"
                  maxlength="40"
                  value={place.cuisine ?? ""}
                />
              </label>
              <label class="flex flex-col gap-1">
                <span class="label-text">Tags (optional, comma-separated)</span>
                <input
                  name="tags"
                  class="input input-bordered w-full"
                  maxlength="200"
                  placeholder="quick, terrace, vegan-friendly"
                  value={parseTagsJson(place.tags).join(", ")}
                />
              </label>
              <label class="flex flex-col gap-1">
                <span class="label-text">Address (optional)</span>
                <input
                  name="address"
                  class="input input-bordered w-full"
                  maxlength="200"
                  placeholder="Mannerheimintie 1, 00100 Helsinki"
                  value={place.address ?? ""}
                />
              </label>
              <label class="flex flex-col gap-1">
                <span class="label-text">Coordinates</span>
                <input
                  name="coords"
                  class="input input-bordered w-full"
                  placeholder="60.1699, 24.9384"
                  value={
                    place.lat !== null && place.lng !== null
                      ? `${place.lat}, ${place.lng}`
                      : ""
                  }
                />
              </label>
              <div class="modal-action">
                <button
                  type="button"
                  class="btn"
                  onclick="edit_place_modal.close()"
                >
                  Cancel
                </button>
                <button class="btn btn-primary" type="submit">
                  Save
                </button>
              </div>
            </form>
          </div>
          <form method="dialog" class="modal-backdrop">
            <button>close</button>
          </form>
        </dialog>
      )
    }
    {editError && <script is:inline>edit_place_modal.showModal();</script>}

    <datalist id="cuisines">
      <option value="buffet"></option>
      <option value="burgers"></option>
      <option value="chinese"></option>
      <option value="indian"></option>
      <option value="italian"></option>
      <option value="japanese"></option>
      <option value="kebab"></option>
      <option value="korean"></option>
      <option value="mexican"></option>
      <option value="nepalese"></option>
      <option value="pizza"></option>
      <option value="salads"></option>
      <option value="sushi"></option>
      <option value="thai"></option>
      <option value="vegan"></option>
      <option value="vietnamese"></option>
    </datalist>

    <div class="card bg-base-100 shadow-sm">
      <div class="card-body gap-2 py-4">
        {
          place.url && (
            <p>
              <a href={place.url} target="_blank" rel="noopener" class="link">
                {place.url} ↗
              </a>
            </p>
          )
        }
        {place.notes && <p class="text-base-content/80">{place.notes}</p>}
        {
          (place.address || (place.lat !== null && place.lng !== null)) && (
            <p class="text-base-content/70 text-sm">
              📍 {place.address || `${place.lat}, ${place.lng}`}
            </p>
          )
        }
        <p class="text-base-content/50 text-sm">
          Added by {place.created_by} on {place.created_at.slice(0, 10)}
        </p>
      </div>
    </div>

    {
      place.lat !== null && place.lng !== null && (
        <PlaceMap
          markers={[
            {
              lat: place.lat,
              lng: place.lng,
              name: place.name,
              address: place.address ?? undefined,
            },
          ]}
        />
      )
    }

    <div class="stats bg-base-100 shadow-sm">
      <div class="stat">
        <div class="stat-title">Times chosen</div>
        <div class="stat-value">{chosenIn.length}</div>
      </div>
      <div class="stat">
        <div class="stat-title">Votes received</div>
        <div class="stat-value">{totalVotes}</div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
      <div class="card-body py-4">
        <h2 class="text-sm font-semibold uppercase opacity-60">
          Opening hours
        </h2>
        {
          hoursError && (
            <div class="alert alert-error text-sm">{hoursError}</div>
          )
        }
        {
          hours.length === 0 ? (
            <p class="text-base-content/60 text-sm">
              No hours set — assumed open every day.
            </p>
          ) : (
            <ul class="flex flex-col gap-0.5 text-sm sm:w-64">
              {WEEKDAY_NAMES.map((name, i) => {
                const h = hours.find((r) => r.weekday === i + 1);
                return (
                  <li class="flex justify-between">
                    <span>{name}</span>
                    <span class={h ? "" : "text-base-content/50"}>
                      {h ? `${h.open_time}–${h.close_time}` : "Closed"}
                    </span>
                  </li>
                );
              })}
            </ul>
          )
        }
        {
          isAdmin && (
            <details>
              <summary class="text-base-content/60 cursor-pointer text-xs select-none">
                Edit hours
              </summary>
              <form
                method="POST"
                action={actions.places.setHours}
                class="flex flex-col gap-1 py-2"
              >
                <input type="hidden" name="placeId" value={place.id} />
                {WEEKDAY_NAMES.map((name, i) => {
                  const h = hours.find((r) => r.weekday === i + 1);
                  return (
                    <label class="flex items-center gap-2 text-sm">
                      <span class="w-24">{name}</span>
                      <input
                        type="time"
                        name={`open${i + 1}`}
                        class="input input-bordered input-xs"
                        value={h?.open_time ?? ""}
                      />
                      <span>–</span>
                      <input
                        type="time"
                        name={`close${i + 1}`}
                        class="input input-bordered input-xs"
                        value={h?.close_time ?? ""}
                      />
                    </label>
                  );
                })}
                <p class="text-base-content/50 text-xs">
                  Leave both fields empty for a day the place is closed; clear
                  every field if the hours are unknown.
                </p>
                <button class="btn btn-primary btn-sm self-start" type="submit">
                  Save hours
                </button>
              </form>
            </details>
          )
        }
      </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
      <div class="card-body py-4">
        <h2 class="text-sm font-semibold uppercase opacity-60">Closures</h2>
        {
          closures.length === 0 && (
            <p class="text-base-content/60 text-sm">
              No exceptional closures (renovations, vacations, holidays).
            </p>
          )
        }
        <ul class="flex flex-col gap-1 text-sm">
          {
            closures.map((c) => (
              <li class="flex flex-wrap items-center gap-2">
                <span>
                  {c.start_date === c.end_date
                    ? c.start_date
                    : `${c.start_date} – ${c.end_date}`}{" "}
                  — {c.reason}
                </span>
                {c.start_date <= today && today <= c.end_date && (
                  <span class="badge badge-warning badge-sm">active</span>
                )}
                <span class="text-base-content/50 text-xs">
                  by {c.created_by}
                </span>
                {isAdmin && (
                  <form
                    method="POST"
                    action={actions.places.deleteClosure}
                    onsubmit={`return confirm(${JSON.stringify(`Delete the closure "${c.reason}"?`)})`}
                  >
                    <input type="hidden" name="closureId" value={c.id} />
                    <button
                      class="btn btn-ghost btn-xs text-error"
                      type="submit"
                    >
                      Delete
                    </button>
                  </form>
                )}
              </li>
            ))
          }
        </ul>
        {
          isAdmin && (
            <form
              method="POST"
              action={actions.places.addClosure}
              class="mt-4 flex flex-wrap items-end gap-x-3 gap-y-2"
            >
              <input type="hidden" name="placeId" value={place.id} />
              <div class="flex flex-col gap-1">
                <span class="label-text text-xs">From</span>
                <DatePicker name="startDate" />
              </div>
              <div class="flex flex-col gap-1">
                <span class="label-text text-xs">To</span>
                <DatePicker name="endDate" />
              </div>
              <label class="flex flex-col gap-1">
                <span class="label-text text-xs">Reason</span>
                <input
                  name="reason"
                  class="input input-bordered input-sm"
                  placeholder="renovation"
                  required
                  maxlength="120"
                />
              </label>
              <button class="btn btn-primary btn-sm" type="submit">
                Add closure
              </button>
            </form>
          )
        }
      </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
      <div class="card-body py-4">
        <h2 class="text-sm font-semibold uppercase opacity-60">Menu</h2>
        {menuError && <div class="alert alert-error text-sm">{menuError}</div>}
        {
          menu.length === 0 && (
            <p class="text-base-content/60 text-sm">
              Nothing on the menu yet — add the first item below.
            </p>
          )
        }
        <ul class="flex flex-col">
          {
            menu.map((item) => (
              <li class="border-base-200 border-b py-2 last:border-b-0">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-medium">{item.name}</span>
                  <span class="flex items-center gap-2">
                    <span class="badge badge-neutral">
                      {formatPrice(item.prices[0]!.price_cents)}
                    </span>
                    {isAdmin && (
                      <form
                        method="POST"
                        action={actions.menu.deleteItem}
                        onsubmit={`return confirm(${JSON.stringify(`Delete ${item.name} and its price history?`)})`}
                      >
                        <input type="hidden" name="itemId" value={item.id} />
                        <button
                          class="btn btn-ghost btn-xs text-error"
                          type="submit"
                        >
                          Delete
                        </button>
                      </form>
                    )}
                  </span>
                </div>
                <details>
                  <summary class="text-base-content/60 cursor-pointer text-xs select-none">
                    Price history ({item.prices.length}) · update
                  </summary>
                  <div class="flex flex-col gap-2 py-2 pl-2">
                    <ul class="text-base-content/70 flex flex-col gap-0.5 text-sm">
                      {item.prices.map((p, i) => (
                        <li>
                          {formatPrice(p.price_cents)}
                          {i === 0 && " (current)"}
                          <span class="text-base-content/50 text-xs">
                            {" "}
                            — {p.recorded_at.slice(0, 10)} by {p.recorded_by}
                          </span>
                        </li>
                      ))}
                    </ul>
                    <form
                      method="POST"
                      action={actions.menu.recordPrice}
                      class="flex items-center gap-2"
                    >
                      <input type="hidden" name="itemId" value={item.id} />
                      <input
                        name="price"
                        class="input input-bordered input-xs w-24"
                        placeholder="12.50"
                        required
                      />
                      <button class="btn btn-xs" type="submit">
                        New price
                      </button>
                    </form>
                  </div>
                </details>
              </li>
            ))
          }
        </ul>
        <form
          method="POST"
          action={actions.menu.addItem}
          class="mt-4 flex flex-wrap items-end gap-x-3 gap-y-2"
        >
          <input type="hidden" name="placeId" value={place.id} />
          <label class="flex flex-col gap-1">
            <span class="label-text text-xs">Item (dish or buffet)</span>
            <input
              name="name"
              class="input input-bordered input-sm"
              required
              maxlength="80"
            />
          </label>
          <label class="flex flex-col gap-1">
            <span class="label-text text-xs">Price €</span>
            <input
              name="price"
              class="input input-bordered input-sm w-24"
              placeholder="12.50"
              required
            />
          </label>
          <button class="btn btn-primary btn-sm" type="submit">Add</button>
        </form>
      </div>
    </div>

    {
      chosenIn.length > 0 && (
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body py-4">
            <h2 class="text-sm font-semibold uppercase opacity-60">
              Chosen on
            </h2>
            <ul class="flex flex-col gap-1">
              {chosenIn.map((s) => (
                <li>
                  <a href={`/sessions/${s.public_id}`} class="link">
                    {s.date}
                  </a>{" "}
                  <span class="text-base-content/60 text-sm">
                    {modeEmoji[s.mode]} {s.mode}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }

    <a href="/places" class="link text-sm">← All places</a>
  </div>
</Layout>
