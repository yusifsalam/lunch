---
import Layout from "@/layouts/Layout.astro";
import DatePicker from "@/components/DatePicker.astro";
import PlaceMap from "@/components/PlaceMap.astro";
import { actions } from "astro:actions";
import { WEEKDAY_NAMES } from "@/lib/hours";
import { todayInfo } from "@/lib/lunch";
import { formatPrice } from "@/lib/money";
import { TZ } from "@/lib/lunchService";
import { parseTagsJson } from "@/lib/tags";

// Editing can rename the place and thus change its slug; follow it so the
// post-submit render doesn't 404 on the old URL.
const editResult = Astro.getActionResult(actions.places.edit);
if (editResult?.data && editResult.data.slug !== Astro.params.slug) {
  return Astro.redirect(`/places/${editResult.data.slug}`);
}
const editError = editResult?.error?.message;

const detail = await Astro.locals.service.placeDetail(Astro.params.slug ?? "");
if (!detail) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

const {
  place,
  chosenIn,
  totalVotes,
  menu,
  hours,
  closures,
  ratings,
  closedReason,
} = detail;
const user = Astro.locals.user;
const isAdmin = user.role === "admin";
const { date: today } = todayInfo(new Date(), TZ);

const canRate = await Astro.locals.service.canRate(place.id, user.name);
const myRating =
  ratings.current.find(
    (r) => r.rater_name.toLowerCase() === user.name.toLowerCase(),
  )?.rating ?? null;
const rateError =
  Astro.getActionResult(actions.places.rate)?.error?.message ??
  Astro.getActionResult(actions.places.deleteRating)?.error?.message ??
  Astro.getActionResult(actions.places.deleteRatingEntry)?.error?.message;
const stars = (n: number) =>
  "★".repeat(Math.floor(n)) +
  (Number.isInteger(n) ? "" : "½") +
  "☆".repeat(5 - Math.ceil(n));

const addItemResult = Astro.getActionResult(actions.menu.addItem);
const recordPriceResult = Astro.getActionResult(actions.menu.recordPrice);
const menuError =
  addItemResult?.error?.message ?? recordPriceResult?.error?.message;

const setHoursResult = Astro.getActionResult(actions.places.setHours);
const addClosureResult = Astro.getActionResult(actions.places.addClosure);
const deleteClosureResult = Astro.getActionResult(actions.places.deleteClosure);
const hoursError =
  setHoursResult?.error?.message ??
  addClosureResult?.error?.message ??
  deleteClosureResult?.error?.message;

const modeEmoji: Record<string, string> = {
  democracy: "🗳️",
  dictatorship: "👑",
  random: "🎲",
};
---

<Layout title={`${place.name} — Lunch`}>
  <div class="flex flex-col gap-4">
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="text-2xl font-bold">{place.name}</h1>
      {
        place.cuisine && (
          <span class="badge badge-outline">{place.cuisine}</span>
        )
      }
      {
        parseTagsJson(place.tags).map((tag) => (
          <span class="badge badge-soft">{tag}</span>
        ))
      }
      {place.archived === 1 && <span class="badge badge-ghost">archived</span>}
      {
        closedReason && (
          <span class="badge badge-warning">today: {closedReason}</span>
        )
      }
      {
        isAdmin && (
          <button
            class="btn btn-sm ml-auto"
            onclick="edit_place_modal.showModal()"
          >
            Edit
          </button>
        )
      }
    </div>

    {
      isAdmin && (
        <dialog id="edit_place_modal" class="modal backdrop-blur-sm">
          <div class="modal-box">
            <h2 class="mb-4 text-lg font-bold">Edit place</h2>
            {editError && (
              <div class="alert alert-error mb-4 text-sm">{editError}</div>
            )}
            <form
              method="POST"
              action={actions.places.edit}
              class="flex flex-col gap-3"
            >
              <input type="hidden" name="id" value={place.id} />
              <label class="flex flex-col gap-1">
                <span class="label-text">Name</span>
                <input
                  name="name"
                  class="input input-bordered w-full"
                  required
                  maxlength="80"
                  value={place.name}
                />
              </label>
              <label class="flex flex-col gap-1">
                <span class="label-text">URL (optional)</span>
                <input
                  name="url"
                  type="url"
                  class="input input-bordered w-full"
                  placeholder="https://…"
                  value={place.url ?? ""}
                />
              </label>
              <label class="flex flex-col gap-1">
                <span class="label-text">Notes (optional)</span>
                <input
                  name="notes"
                  class="input input-bordered w-full"
                  maxlength="500"
                  value={place.notes ?? ""}
                />
              </label>
              <label class="flex flex-col gap-1">
                <span class="label-text">Cuisine</span>
                <input
                  name="cuisine"
                  list="cuisines"
                  class="input input-bordered w-full"
                  maxlength="40"
                  value={place.cuisine ?? ""}
                />
              </label>
              <label class="flex flex-col gap-1">
                <span class="label-text">Tags (optional, comma-separated)</span>
                <input
                  name="tags"
                  class="input input-bordered w-full"
                  maxlength="200"
                  placeholder="quick, terrace, vegan-friendly"
                  value={parseTagsJson(place.tags).join(", ")}
                />
              </label>
              <label class="flex flex-col gap-1">
                <span class="label-text">Address (optional)</span>
                <input
                  name="address"
                  class="input input-bordered w-full"
                  maxlength="200"
                  placeholder="Mannerheimintie 1, 00100 Helsinki"
                  value={place.address ?? ""}
                />
              </label>
              <label class="flex flex-col gap-1">
                <span class="label-text">Coordinates</span>
                <input
                  name="coords"
                  class="input input-bordered w-full"
                  placeholder="60.1699, 24.9384"
                  value={
                    place.lat !== null && place.lng !== null
                      ? `${place.lat}, ${place.lng}`
                      : ""
                  }
                />
              </label>
              <div class="modal-action">
                <button
                  type="button"
                  class="btn"
                  onclick="edit_place_modal.close()"
                >
                  Cancel
                </button>
                <button class="btn btn-primary" type="submit">
                  Save
                </button>
              </div>
            </form>
          </div>
          <form method="dialog" class="modal-backdrop">
            <button>close</button>
          </form>
        </dialog>
      )
    }
    {editError && <script is:inline>edit_place_modal.showModal();</script>}

    <datalist id="cuisines">
      <option value="buffet"></option>
      <option value="burgers"></option>
      <option value="chinese"></option>
      <option value="indian"></option>
      <option value="italian"></option>
      <option value="japanese"></option>
      <option value="kebab"></option>
      <option value="korean"></option>
      <option value="mexican"></option>
      <option value="nepalese"></option>
      <option value="pizza"></option>
      <option value="salads"></option>
      <option value="sushi"></option>
      <option value="thai"></option>
      <option value="vegan"></option>
      <option value="vietnamese"></option>
    </datalist>

    <div class="card bg-base-100 shadow-sm">
      <div class="card-body gap-2 py-4">
        {
          place.url && (
            <p>
              <a href={place.url} target="_blank" rel="noopener" class="link">
                {place.url} ↗
              </a>
            </p>
          )
        }
        {place.notes && <p class="text-base-content/80">{place.notes}</p>}
        {
          (place.address || (place.lat !== null && place.lng !== null)) && (
            <p class="text-base-content/70 text-sm">
              📍 {place.address || `${place.lat}, ${place.lng}`}
            </p>
          )
        }
        <p class="text-base-content/50 text-sm">
          Added by {place.created_by} on {place.created_at.slice(0, 10)}
        </p>
      </div>
    </div>

    {
      place.lat !== null && place.lng !== null && (
        <PlaceMap
          markers={[
            {
              lat: place.lat,
              lng: place.lng,
              name: place.name,
              address: place.address ?? undefined,
            },
          ]}
        />
      )
    }

    <div class="stats bg-base-100 shadow-sm">
      <div class="stat">
        <div class="stat-title">Times chosen</div>
        <div class="stat-value">{chosenIn.length}</div>
      </div>
      <div class="stat">
        <div class="stat-title">Votes received</div>
        <div class="stat-value">{totalVotes}</div>
      </div>
      <div class="stat">
        <div class="stat-title">Rating</div>
        <div class="stat-value">
          {ratings.average === null ? "—" : `${ratings.average.toFixed(1)} ★`}
        </div>
        {
          ratings.current.length > 0 && (
            <div class="stat-desc">
              {ratings.current.length}{" "}
              {ratings.current.length === 1 ? "rating" : "ratings"}
            </div>
          )
        }
      </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
      <div class="card-body py-4">
        <h2 class="text-sm font-semibold uppercase opacity-60">Ratings</h2>
        {rateError && <div class="alert alert-error text-sm">{rateError}</div>}
        {
          ratings.current.length === 0 && (
            <p class="text-base-content/60 text-sm">No ratings yet.</p>
          )
        }
        <ul class="flex flex-col gap-0.5 text-sm">
          {
            ratings.current.map((r) => (
              <li class="flex items-center gap-2">
                <span class="w-28">{r.rater_name}</span>
                <span class="text-amber-400" aria-label={`${r.rating} of 5`}>
                  {stars(r.rating)}
                </span>
                <span class="text-base-content/50 text-xs">
                  {r.rated_at.slice(0, 10)}
                </span>
                {(isAdmin ||
                  r.rater_name.toLowerCase() === user.name.toLowerCase()) && (
                  <form
                    method="POST"
                    action={actions.places.deleteRating}
                    onsubmit={`return confirm(${JSON.stringify(`Remove ${r.rater_name}'s rating and its history?`)})`}
                  >
                    <input type="hidden" name="placeId" value={place.id} />
                    <input
                      type="hidden"
                      name="raterName"
                      value={r.rater_name}
                    />
                    <button
                      class="btn btn-ghost btn-xs text-error"
                      type="submit"
                    >
                      Remove
                    </button>
                  </form>
                )}
              </li>
            ))
          }
        </ul>
        {
          canRate ? (
            <form
              method="POST"
              action={actions.places.rate}
              class="mt-2 flex items-center gap-3"
            >
              <input type="hidden" name="placeId" value={place.id} />
              <div class="rating rating-half rating-anim">
                {Array.from({ length: 10 }, (_, i) => (i + 1) / 2).map((n) => (
                  <input
                    type="radio"
                    name="rating"
                    value={n}
                    class:list={[
                      "mask mask-star-2 bg-amber-400",
                      Number.isInteger(n) ? "mask-half-2" : "mask-half-1",
                    ]}
                    aria-label={`${n} star${n === 1 ? "" : "s"}`}
                    checked={myRating === n}
                    required
                  />
                ))}
              </div>
              <button class="btn btn-primary btn-sm" type="submit">
                {myRating === null ? "Rate" : "Update rating"}
              </button>
            </form>
          ) : (
            <p class="text-base-content/50 text-xs">
              You can rate {place.name} after eating there on a lunch day.
            </p>
          )
        }
        {
          ratings.history.length > ratings.current.length && (
            <details>
              <summary class="text-base-content/60 cursor-pointer text-xs select-none">
                Rating history ({ratings.history.length})
              </summary>
              <ul class="text-base-content/70 flex flex-col gap-0.5 py-2 pl-2 text-sm">
                {ratings.history.map((r) => (
                  <li class="flex items-center gap-2">
                    <span>
                      <span class="text-amber-400">{stars(r.rating)}</span>
                      <span class="text-base-content/50 text-xs">
                        {" "}
                        — {r.rated_at.slice(0, 10)} by {r.rater_name}
                      </span>
                    </span>
                    {(isAdmin ||
                      r.rater_name.toLowerCase() ===
                        user.name.toLowerCase()) && (
                      <form
                        method="POST"
                        action={actions.places.deleteRatingEntry}
                        onsubmit={`return confirm(${JSON.stringify(`Delete this ${r.rating}-star entry by ${r.rater_name}? Deleting the newest one reverts to the previous rating.`)})`}
                      >
                        <input type="hidden" name="ratingId" value={r.id} />
                        <button
                          class="btn btn-ghost btn-xs text-error"
                          type="submit"
                        >
                          Delete
                        </button>
                      </form>
                    )}
                  </li>
                ))}
              </ul>
            </details>
          )
        }
      </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
      <div class="card-body py-4">
        <h2 class="text-sm font-semibold uppercase opacity-60">
          Opening hours
        </h2>
        {
          hoursError && (
            <div class="alert alert-error text-sm">{hoursError}</div>
          )
        }
        {
          hours.length === 0 ? (
            <p class="text-base-content/60 text-sm">
              No hours set — assumed open every day.
            </p>
          ) : (
            <ul class="flex flex-col gap-0.5 text-sm">
              {WEEKDAY_NAMES.map((name, i) => {
                const h = hours.find((r) => r.weekday === i + 1);
                const hasLunch = hours.some((r) => r.lunch_open);
                return (
                  <li class="flex">
                    <span class="w-28">{name}</span>
                    <span class={h ? "" : "text-base-content/50"}>
                      {h ? `${h.open_time}–${h.close_time}` : "Closed"}
                      {h?.lunch_open && (
                        <span class="text-base-content/60">
                          {" "}
                          · lunch {h.lunch_open}–{h.lunch_close}
                        </span>
                      )}
                      {h && !h.lunch_open && hasLunch && (
                        <span class="text-base-content/50"> · no lunch</span>
                      )}
                    </span>
                  </li>
                );
              })}
            </ul>
          )
        }
        {
          isAdmin && (
            <details>
              <summary class="text-base-content/60 cursor-pointer text-xs select-none">
                Edit hours
              </summary>
              <form
                method="POST"
                action={actions.places.setHours}
                class="flex flex-col gap-2 overflow-x-auto py-2"
              >
                <input type="hidden" name="placeId" value={place.id} />
                <div class="grid w-fit grid-cols-[auto_repeat(3,auto)_1rem_repeat(3,auto)_auto] items-center gap-x-1.5 gap-y-1 text-sm">
                  <span />
                  <span class="text-base-content/50 col-span-3 text-center text-xs">
                    open
                  </span>
                  <span />
                  <span class="text-base-content/50 col-span-3 text-center text-xs">
                    lunch
                  </span>
                  <span />
                  {WEEKDAY_NAMES.map((name, i) => {
                    const h = hours.find((r) => r.weekday === i + 1);
                    return (
                      <>
                        <span class="pr-2">{name}</span>
                        {/* type="text", not "time": native time inputs ignore
                            placeholder and paint their own hint text. */}
                        <input
                          type="text"
                          inputmode="numeric"
                          maxlength="5"
                          placeholder="10:00"
                          name={`open${i + 1}`}
                          class="input input-bordered input-xs w-20"
                          value={h?.open_time ?? ""}
                        />
                        <span class="text-base-content/50">–</span>
                        <input
                          type="text"
                          inputmode="numeric"
                          maxlength="5"
                          placeholder="20:00"
                          name={`close${i + 1}`}
                          class="input input-bordered input-xs w-20"
                          value={h?.close_time ?? ""}
                        />
                        <span />
                        <input
                          type="text"
                          inputmode="numeric"
                          maxlength="5"
                          placeholder="11:00"
                          name={`lunchOpen${i + 1}`}
                          class="input input-bordered input-xs w-20"
                          value={h?.lunch_open ?? ""}
                        />
                        <span class="text-base-content/50">–</span>
                        <input
                          type="text"
                          inputmode="numeric"
                          maxlength="5"
                          placeholder="14:00"
                          name={`lunchClose${i + 1}`}
                          class="input input-bordered input-xs w-20"
                          value={h?.lunch_close ?? ""}
                        />
                        <button
                          type="button"
                          class:list={[
                            "btn btn-ghost btn-xs",
                            i === 0 && "invisible",
                          ]}
                          title={
                            i > 0
                              ? `Copy ${WEEKDAY_NAMES[i - 1]}'s hours`
                              : undefined
                          }
                          onclick={`this.form.open${i + 1}.value = this.form.open${i}.value; this.form.close${i + 1}.value = this.form.close${i}.value; this.form.lunchOpen${i + 1}.value = this.form.lunchOpen${i}.value; this.form.lunchClose${i + 1}.value = this.form.lunchClose${i}.value;`}
                          disabled={i === 0}
                        >
                          ↑ copy
                        </button>
                      </>
                    );
                  })}
                </div>
                <p class="text-base-content/50 text-xs">
                  Leave a day's fields empty if the place is closed that day;
                  clear every field if the hours are unknown. Lunch times are
                  optional, but once any day has them, a day without is treated
                  as not serving lunch.
                </p>
                <button class="btn btn-primary btn-sm self-start" type="submit">
                  Save hours
                </button>
              </form>
            </details>
          )
        }
      </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
      <div class="card-body py-4">
        <h2 class="text-sm font-semibold uppercase opacity-60">Closures</h2>
        {
          closures.length === 0 && (
            <p class="text-base-content/60 text-sm">
              No exceptional closures (renovations, vacations, holidays).
            </p>
          )
        }
        <ul class="flex flex-col gap-1 text-sm">
          {
            closures.map((c) => (
              <li class="flex flex-wrap items-center gap-2">
                <span>
                  {c.start_date === c.end_date
                    ? c.start_date
                    : `${c.start_date} – ${c.end_date}`}{" "}
                  — {c.reason}
                </span>
                {c.start_date <= today && today <= c.end_date && (
                  <span class="badge badge-warning badge-sm">active</span>
                )}
                <span class="text-base-content/50 text-xs">
                  by {c.created_by}
                </span>
                {isAdmin && (
                  <form
                    method="POST"
                    action={actions.places.deleteClosure}
                    onsubmit={`return confirm(${JSON.stringify(`Delete the closure "${c.reason}"?`)})`}
                  >
                    <input type="hidden" name="closureId" value={c.id} />
                    <button
                      class="btn btn-ghost btn-xs text-error"
                      type="submit"
                    >
                      Delete
                    </button>
                  </form>
                )}
              </li>
            ))
          }
        </ul>
        {
          isAdmin && (
            <form
              method="POST"
              action={actions.places.addClosure}
              class="mt-4 flex flex-wrap items-end gap-x-3 gap-y-2"
            >
              <input type="hidden" name="placeId" value={place.id} />
              <div class="flex flex-col gap-1">
                <span class="label-text text-xs">From</span>
                <DatePicker name="startDate" />
              </div>
              <div class="flex flex-col gap-1">
                <span class="label-text text-xs">To</span>
                <DatePicker name="endDate" />
              </div>
              <label class="flex flex-col gap-1">
                <span class="label-text text-xs">Reason</span>
                <input
                  name="reason"
                  class="input input-bordered input-sm"
                  placeholder="renovation"
                  required
                  maxlength="120"
                />
              </label>
              <button class="btn btn-primary btn-sm" type="submit">
                Add closure
              </button>
            </form>
          )
        }
      </div>
    </div>

    <div class="card bg-base-100 shadow-sm">
      <div class="card-body py-4">
        <h2 class="text-sm font-semibold uppercase opacity-60">Menu</h2>
        {menuError && <div class="alert alert-error text-sm">{menuError}</div>}
        {
          menu.length === 0 && (
            <p class="text-base-content/60 text-sm">
              Nothing on the menu yet — add the first item below.
            </p>
          )
        }
        <ul class="flex flex-col">
          {
            menu.map((item) => (
              <li class="border-base-200 border-b py-2 last:border-b-0">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-medium">{item.name}</span>
                  <span class="flex items-center gap-2">
                    <span class="badge badge-neutral">
                      {formatPrice(item.prices[0]!.price_cents)}
                    </span>
                    {isAdmin && (
                      <form
                        method="POST"
                        action={actions.menu.deleteItem}
                        onsubmit={`return confirm(${JSON.stringify(`Delete ${item.name} and its price history?`)})`}
                      >
                        <input type="hidden" name="itemId" value={item.id} />
                        <button
                          class="btn btn-ghost btn-xs text-error"
                          type="submit"
                        >
                          Delete
                        </button>
                      </form>
                    )}
                  </span>
                </div>
                <details>
                  <summary class="text-base-content/60 cursor-pointer text-xs select-none">
                    Price history ({item.prices.length}) · update
                  </summary>
                  <div class="flex flex-col gap-2 py-2 pl-2">
                    <ul class="text-base-content/70 flex flex-col gap-0.5 text-sm">
                      {item.prices.map((p, i) => (
                        <li>
                          {formatPrice(p.price_cents)}
                          {i === 0 && " (current)"}
                          <span class="text-base-content/50 text-xs">
                            {" "}
                            — {p.recorded_at.slice(0, 10)} by {p.recorded_by}
                          </span>
                        </li>
                      ))}
                    </ul>
                    <form
                      method="POST"
                      action={actions.menu.recordPrice}
                      class="flex items-center gap-2"
                    >
                      <input type="hidden" name="itemId" value={item.id} />
                      <input
                        name="price"
                        class="input input-bordered input-xs w-24"
                        placeholder="12.50"
                        required
                      />
                      <button class="btn btn-xs" type="submit">
                        New price
                      </button>
                    </form>
                  </div>
                </details>
              </li>
            ))
          }
        </ul>
        <form
          method="POST"
          action={actions.menu.addItem}
          class="mt-4 flex flex-wrap items-end gap-x-3 gap-y-2"
        >
          <input type="hidden" name="placeId" value={place.id} />
          <label class="flex flex-col gap-1">
            <span class="label-text text-xs">Item (dish or buffet)</span>
            <input
              name="name"
              class="input input-bordered input-sm"
              required
              maxlength="80"
            />
          </label>
          <label class="flex flex-col gap-1">
            <span class="label-text text-xs">Price €</span>
            <input
              name="price"
              class="input input-bordered input-sm w-24"
              placeholder="12.50"
              required
            />
          </label>
          <button class="btn btn-primary btn-sm" type="submit">Add</button>
        </form>
      </div>
    </div>

    {
      chosenIn.length > 0 && (
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body py-4">
            <h2 class="text-sm font-semibold uppercase opacity-60">
              Chosen on
            </h2>
            <ul class="flex flex-col gap-1">
              {chosenIn.map((s) => (
                <li>
                  <a href={`/sessions/${s.public_id}`} class="link">
                    {s.date}
                  </a>{" "}
                  {s.name && (
                    <span class="text-base-content/60 text-sm">
                      🚂 {s.name}
                    </span>
                  )}{" "}
                  <span class="text-base-content/60 text-sm">
                    {modeEmoji[s.mode]} {s.mode}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }

    <a href="/places" class="link text-sm">← All places</a>
  </div>
</Layout>

<!-- Rating-picker animations. Global on purpose: daisyUI paints the fill via
     opacity inside @layer, and only unlayered rules reliably override it. -->
<style is:global>
  .rating-anim input {
    transition:
      opacity 0.15s ease,
      scale 0.18s ease,
      filter 0.18s ease;
  }
  /* Halves scale from the star's center seam so each star grows as one. */
  .rating-anim input:nth-child(odd) {
    transform-origin: 100% 50%;
  }
  .rating-anim input:nth-child(even) {
    transform-origin: 0% 50%;
  }
  /* Hover preview: light the stars up to the cursor, dim the rest. */
  .rating-anim:hover input {
    opacity: 0.2;
  }
  .rating-anim:hover input:hover,
  .rating-anim:hover input:has(~ input:hover) {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* The star under the cursor (both halves) springs up… */
    .rating-anim input:hover,
    .rating-anim input:nth-child(odd):hover + input,
    .rating-anim input:has(+ input:nth-child(even):hover) {
      scale: 1.25;
      filter: brightness(1.1);
    }
    /* …and the chosen star pops when the pick lands. */
    .rating-anim input:checked,
    .rating-anim input:nth-child(odd):checked + input,
    .rating-anim input:has(+ input:nth-child(even):checked) {
      animation: star-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
  }
  @keyframes star-pop {
    0% {
      scale: 1;
    }
    40% {
      scale: 1.4;
      filter: brightness(1.3);
    }
    100% {
      scale: 1;
      filter: brightness(1);
    }
  }
</style>
