---
import Layout from "@/layouts/Layout.astro";
import PlaceMap from "@/components/PlaceMap.astro";
import { db } from "@/db/db";

const places = await db
  .selectFrom("place")
  .select(["name", "slug", "address", "lat", "lng"])
  .where("archived", "=", 0)
  .orderBy("name")
  .execute();

const located = places.filter((p) => p.lat !== null && p.lng !== null);
const missing = places.filter((p) => p.lat === null || p.lng === null);

const markers = located.map((p) => ({
  lat: p.lat!,
  lng: p.lng!,
  name: p.name,
  slug: p.slug,
  address: p.address ?? undefined,
}));
---

<Layout title="Map — Lunch" fullBleed>
  {
    located.length > 0 ? (
      <div class="relative h-full">
        <PlaceMap markers={markers} class="h-full" />
        {missing.length > 0 && (
          <p class="bg-base-100/80 text-base-content/70 rounded-box absolute bottom-2 left-2 z-10 max-w-sm px-3 py-2 text-xs shadow-sm backdrop-blur">
            No coordinates yet:{" "}
            {missing.map((p, i) => (
              <>
                {i > 0 && ", "}
                <a href={`/places/${p.slug}`} class="link">
                  {p.name}
                </a>
              </>
            ))}
          </p>
        )}
      </div>
    ) : (
      <div class="text-base-content/60 flex h-full items-center justify-center p-8 text-center">
        <span>
          No places have coordinates yet — add them on the{" "}
          <a href="/places" class="link">
            Places
          </a>{" "}
          page.
        </span>
      </div>
    )
  }
</Layout>
