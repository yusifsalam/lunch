---
import Layout from "@/layouts/Layout.astro";
import { actions } from "astro:actions";
import { db } from "@/db/db";
import { service } from "@/lib/service";

const user = Astro.locals.user;
const isAdmin = user.role === "admin";

const addResult = Astro.getActionResult(actions.places.add);
const deleteResult = Astro.getActionResult(actions.places.delete);
const addError = addResult?.error?.message;
const error = deleteResult?.error?.message;

const places = await db
  .selectFrom("place")
  .selectAll()
  .orderBy("archived")
  .orderBy("name")
  .execute();
const closedToday = await service.closedPlacesToday();
---

<Layout title="Places — Lunch">
  <div class="mb-4 flex items-center justify-between">
    <h1 class="text-2xl font-bold">Places</h1>
    <button
      class="btn btn-primary btn-sm"
      onclick="add_place_modal.showModal()"
    >
      Add a place
    </button>
  </div>

  {error && <div class="alert alert-error mb-4 text-sm">{error}</div>}

  <dialog id="add_place_modal" class="modal backdrop-blur-sm">
    <div class="modal-box">
      <h2 class="mb-4 text-lg font-bold">Add a place</h2>
      {addError && <div class="alert alert-error mb-4 text-sm">{addError}</div>}
      <form
        method="POST"
        action={actions.places.add}
        class="flex flex-col gap-3"
      >
        <label class="form-control">
          <span class="label-text mb-1">Name</span>
          <input
            name="name"
            class="input input-bordered w-full"
            required
            maxlength="80"
          />
        </label>
        <label class="form-control">
          <span class="label-text mb-1">URL (optional)</span>
          <input
            name="url"
            type="url"
            class="input input-bordered w-full"
            placeholder="https://…"
          />
        </label>
        <label class="form-control">
          <span class="label-text mb-1">Notes (optional)</span>
          <input
            name="notes"
            class="input input-bordered w-full"
            maxlength="500"
          />
        </label>
        <label class="form-control">
          <span class="label-text mb-1">Cuisine</span>
          <input
            name="cuisine"
            list="cuisines"
            class="input input-bordered w-full"
            maxlength="40"
          />
        </label>
        <label class="form-control">
          <span class="label-text mb-1">Address (optional)</span>
          <input
            name="address"
            class="input input-bordered w-full"
            maxlength="200"
            placeholder="Mannerheimintie 1, 00100 Helsinki"
          />
        </label>
        <label class="form-control">
          <span class="label-text mb-1">Coordinates</span>
          <input
            name="coords"
            class="input input-bordered w-full"
            placeholder="60.1699, 24.9384"
          />
        </label>
        <div class="modal-action">
          <button type="button" class="btn" onclick="add_place_modal.close()">
            Cancel
          </button>
          <button class="btn btn-primary" type="submit">Add</button>
        </div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>
  {addError && <script is:inline>add_place_modal.showModal();</script>}

  <datalist id="cuisines">
    <option value="buffet"></option>
    <option value="burgers"></option>
    <option value="chinese"></option>
    <option value="indian"></option>
    <option value="italian"></option>
    <option value="japanese"></option>
    <option value="kebab"></option>
    <option value="korean"></option>
    <option value="mexican"></option>
    <option value="nepalese"></option>
    <option value="pizza"></option>
    <option value="salads"></option>
    <option value="sushi"></option>
    <option value="thai"></option>
    <option value="vegan"></option>
    <option value="vietnamese"></option>
  </datalist>

  <ul class="flex flex-col gap-2">
    {
      places.map((place) => (
        <li
          class={`card bg-base-100 shadow-sm ${place.archived ? "opacity-50" : ""}`}
        >
          <div class="card-body flex-row items-center justify-between gap-2 py-3">
            <div>
              <a href={`/places/${place.slug}`} class="link font-medium">
                {place.name}
              </a>
              {place.cuisine && (
                <span class="badge badge-outline badge-sm ml-2">
                  {place.cuisine}
                </span>
              )}
              {place.url && (
                <a
                  href={place.url}
                  target="_blank"
                  rel="noopener"
                  class="link text-base-content/60 ml-2 text-xs"
                >
                  website ↗
                </a>
              )}
              {place.archived === 1 && (
                <span class="badge badge-ghost badge-sm ml-2">archived</span>
              )}
              {closedToday.has(place.id) && (
                <span
                  class="badge badge-warning badge-sm ml-2"
                  title={closedToday.get(place.id)}
                >
                  closed today
                </span>
              )}
              {place.notes && (
                <p class="text-base-content/70 text-sm">{place.notes}</p>
              )}
              {place.address && (
                <p class="text-base-content/60 text-xs">📍 {place.address}</p>
              )}
              <p class="text-base-content/50 text-xs">
                added by {place.created_by}
              </p>
            </div>
            {isAdmin && (
              <div class="flex items-center gap-1">
                <form method="POST" action={actions.places.setArchived}>
                  <input type="hidden" name="id" value={place.id} />
                  <input
                    type="hidden"
                    name="archived"
                    value={place.archived ? "" : "true"}
                  />
                  <button class="btn btn-ghost btn-xs" type="submit">
                    {place.archived ? "Restore" : "Archive"}
                  </button>
                </form>
                <form
                  method="POST"
                  action={actions.places.delete}
                  onsubmit={`return confirm(${JSON.stringify(`Delete ${place.name}? Votes for it are removed too.`)})`}
                >
                  <input type="hidden" name="id" value={place.id} />
                  <button class="btn btn-ghost btn-xs text-error" type="submit">
                    Delete
                  </button>
                </form>
              </div>
            )}
          </div>
        </li>
      ))
    }
    {
      places.length === 0 && (
        <li class="text-base-content/60 py-8 text-center">
          No places yet — add the first one.
        </li>
      )
    }
  </ul>
</Layout>
