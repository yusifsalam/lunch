---
import Layout from "@/layouts/Layout.astro";
import { actions } from "astro:actions";

const user = Astro.locals.user;
const isAdmin = user.role === "admin";
const deleteResult = Astro.getActionResult(actions.lunch.deleteSession);
const error = deleteResult?.error?.message;

const sessions = await Astro.locals.service.history(30);

// The service enforces creator-or-admin; this only decides button visibility.
const canDelete = (s: (typeof sessions)[number]) =>
  isAdmin || s.created_by?.toLowerCase() === user.name.toLowerCase();
const showActions = sessions.some(canDelete);

const modeEmoji: Record<string, string> = {
  democracy: "🗳️",
  dictatorship: "👑",
  random: "🎲",
};
---

<Layout title="History — Lunch">
  <h1 class="mb-4 text-2xl font-bold">History</h1>
  {error && <div class="alert alert-error mb-4 text-sm">{error}</div>}
  {
    sessions.length === 0 ? (
      <p class="text-base-content/60 py-8 text-center">No sessions yet.</p>
    ) : (
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-0">
          <table class="table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Train</th>
                <th>Mode</th>
                <th>Outcome</th>
                {showActions && <th />}
              </tr>
            </thead>
            <tbody>
              {sessions.map((s) => (
                <tr>
                  <td>
                    <a href={`/sessions/${s.public_id}`} class="link">
                      {s.date}
                    </a>
                  </td>
                  <td>
                    {s.name ?? <span class="text-base-content/50">Lunch</span>}
                  </td>
                  <td>
                    {modeEmoji[s.mode]} {s.mode}
                  </td>
                  <td>
                    {s.status === "finalized" ? (
                      <span class="font-medium">{s.place_name}</span>
                    ) : (
                      <span class="text-base-content/50">undecided</span>
                    )}
                  </td>
                  {showActions && (
                    <td class="text-right">
                      {canDelete(s) && (
                        <form
                          method="POST"
                          action={actions.lunch.deleteSession}
                          onsubmit={`return confirm(${JSON.stringify(`Delete the ${s.name ?? "Lunch"} train of ${s.date}? Its votes and participants are removed too.`)})`}
                        >
                          <input
                            type="hidden"
                            name="publicId"
                            value={s.public_id}
                          />
                          <button
                            class="btn btn-ghost btn-xs text-error"
                            type="submit"
                          >
                            Delete
                          </button>
                        </form>
                      )}
                    </td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )
  }
</Layout>
