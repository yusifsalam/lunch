---
import Layout from "@/layouts/Layout.astro";
import { actions } from "astro:actions";
import { service } from "@/lib/service";

const isAdmin = Astro.locals.user.role === "admin";
const deleteResult = Astro.getActionResult(actions.lunch.deleteSession);
const error = deleteResult?.error?.message;

const sessions = await service.history(30);

const modeEmoji: Record<string, string> = {
  democracy: "🗳️",
  dictatorship: "👑",
  random: "🎲",
};
---

<Layout title="History — Lunch">
  <h1 class="mb-4 text-2xl font-bold">History</h1>
  {error && <div class="alert alert-error mb-4 text-sm">{error}</div>}
  {
    sessions.length === 0 ? (
      <p class="text-base-content/60 py-8 text-center">No sessions yet.</p>
    ) : (
      <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-0">
          <table class="table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Mode</th>
                <th>Outcome</th>
                {isAdmin && <th />}
              </tr>
            </thead>
            <tbody>
              {sessions.map((s) => (
                <tr>
                  <td>
                    <a href={`/sessions/${s.public_id}`} class="link">
                      {s.date}
                    </a>
                  </td>
                  <td>
                    {modeEmoji[s.mode]} {s.mode}
                  </td>
                  <td>
                    {s.status === "finalized" ? (
                      <span class="font-medium">{s.place_name}</span>
                    ) : (
                      <span class="text-base-content/50">undecided</span>
                    )}
                  </td>
                  {isAdmin && (
                    <td class="text-right">
                      <form
                        method="POST"
                        action={actions.lunch.deleteSession}
                        onsubmit={`return confirm(${JSON.stringify(`Delete the ${s.date} session? Its votes and participants are removed too.`)})`}
                      >
                        <input
                          type="hidden"
                          name="publicId"
                          value={s.public_id}
                        />
                        <button
                          class="btn btn-ghost btn-xs text-error"
                          type="submit"
                        >
                          Delete
                        </button>
                      </form>
                    </td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )
  }
</Layout>
