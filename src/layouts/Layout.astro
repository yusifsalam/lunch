---
import "@/styles/global.css";
import Nav from "@/components/Nav.astro";

interface Props {
  title?: string;
  fullBleed?: boolean;
}

const { title = "Lunch", fullBleed = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <script is:inline>
      // Apply the saved theme before first paint; without a saved choice the
      // stylesheet's --prefersdark handling follows the system preference.
      const theme = localStorage.getItem("theme");
      if (theme === "emerald" || theme === "black") {
        document.documentElement.dataset.theme = theme;
      }
    </script>
  </head>
  <body
    class={fullBleed
      ? "bg-base-200 flex h-dvh flex-col"
      : "bg-base-200 min-h-screen"}
  >
    <Nav />
    <main
      class={fullBleed
        ? "min-h-0 w-full flex-1"
        : "mx-auto w-full max-w-3xl p-4"}
    >
      <slot />
    </main>
  </body>
</html>
